model User {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  username          String         @unique
  email             String         @unique
  password          String
  role              String
  department        String?
  firstName         String?
  lastName          String?
  phoneNumber       String?
  organizationId    String         @db.ObjectId
  organization      Organization?  @relation("OrgUsers", fields: [organizationId], references: [id])
  vendorId          String?        @db.ObjectId
  isOwner           Boolean?       @default(false)
  isActive          Boolean?       @default(false)
  emailVerified     Boolean?       @default(false)
  activationToken   String?
  tokenExpiresAt    DateTime?
  moduleAccess      ModuleAccess[] @relation("UserModuleAccess")
  permissions       Json?
  position          String?
  status            String?        @default("active")
  lastLogin         DateTime?
  employeeId        String?
  hireDate          DateTime?
  managerId         String?
  team              String?
  location          Json?
  workSchedule      Json?
  emergencyContact  Json?
  skills            String[]
  certifications    String[]
  education         Json?
  performance       Json?
  compensation      Json?
  benefits          Json?
  equipment         Json?
  accessLevels      Json?
  documents         Json?
  wallet            Json?
  legalDetails      Json?
  address           Json?
  paymentPreference String?        @default("bank") // bank, crypto, hybrid
  cryptoWallets     Json? // Array of crypto wallet addresses
  bankAccounts      Json? // Array of bank account details
  avatarUrl         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  timeTrackingEntries   TimeTrackingEntry[]
  meetings              Meeting[]
  meetingAttendees      MeetingAttendee[]
  assignedTasks         Task[]              @relation("TaskAssignee")
  createdTasks          Task[]              @relation("TaskCreator")
  taskComments          TaskComment[]
  notifications         Notification[]      @relation("UserNotifications")
  jobPostings           JobPosting[]        @relation("UserJobPostings")
  jobApplicationReviews JobApplication[]    @relation("UserJobApplicationReviews")
  payrollApprovals      PayrollRun[]        @relation("UserPayrollApprovals")
  payrollEntries        PayrollEntry[]      @relation("UserPayrollEntries")

  // Procurement Relations
  procurementRequests    ProcurementRequest[]
  procurementApprovals   ProcurementRequest[] @relation("ProcurementApprover")
  purchaseOrderCreators  PurchaseOrder[]      @relation("PurchaseOrderCreator")
  purchaseOrderApprovals PurchaseOrder[]      @relation("PurchaseOrderApprover")
  expenseRequests        ExpenseRequest[]     @relation("ExpenseRequestor")
  expenseApprovals       ExpenseRequest[]     @relation("ExpenseApprover")
  expensePayments        ExpenseRequest[]     @relation("ExpensePayer")
  paymentPayers          Payment[]            @relation("PaymentPayer")
  procurementComments    ProcurementComment[]
  budgetCreators         Budget[]
  rfps                   RFP[] @relation("RFPCreator")
  rfpResponseEvaluations RFPResponse[] @relation("RFPResponseEvaluator")
  contracts              Contract[] @relation("ContractCreator")
  contractLegalReviews   Contract[] @relation("ContractLegalReviewer")
  contractApprovals      Contract[] @relation("ContractApprover")
  grnReceipts            GoodsReceivedNote[] @relation("GRNReceiver")
  vendorEvaluations      VendorPerformance[] @relation("VendorPerformanceEvaluator")
  procurementAudits      ProcurementAudit[] @relation("ProcurementAuditor")

  @@map("users")
}

