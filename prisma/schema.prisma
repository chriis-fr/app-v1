}

model Organization {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String?
  type              String
  industry          String?
  status            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  settings          Json?
  modules           Json?
  logoUrl           String?
  address           Json?
  phoneNumber       String?
  email             String?
  website           String?
  walletAddress     String?
  activeModules     String[]
  maxModules        Int               @default(3)
  waitlistedModules String[]
  users             User[]            @relation("OrgUsers")
  businessPartners  BusinessPartner[]
  vendors           Vendor[]
  notifications     Notification[]    @relation("OrgNotifications")
  jobPostings       JobPosting[]      @relation("OrgJobPostings")
  jobApplications   JobApplication[]  @relation("OrgJobApplications")
  payrollRuns       PayrollRun[]      @relation("OrgPayrollRuns")
  payrollConfigs    PayrollConfig[]   @relation("OrgPayrollConfigs")

  // Procurement Relations
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  suppliers           Supplier[]
  expenseRequests     ExpenseRequest[]
  payments            Payment[]
  budgets             Budget[]
  procurementPolicies ProcurementPolicy[]
  rfps                RFP[]
  contracts           Contract[]
  grns                GoodsReceivedNote[]
  vendorPerformances  VendorPerformance[]
  procurementAudits   ProcurementAudit[]
  procurementCommittees ProcurementCommittee[]

  @@map("organizations")
}

