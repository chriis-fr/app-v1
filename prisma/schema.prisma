model TimeTrackingEntry {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  organizationId String    @db.ObjectId
  projectId      String?   @db.ObjectId
  taskId         String?   @db.ObjectId
  description    String
  type           String
  status         String
  startTime      DateTime
  endTime        DateTime?
  duration       Int? // in minutes
  timezone       String
  location       String?
  tags           String[]
  notes          String?
  billable       Boolean   @default(false)
  hourlyRate     Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])

  @@map("time_tracking_entries")
}

model Meeting {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  organizerId    String   @db.ObjectId
  organizationId String   @db.ObjectId
  type           String
  status         String
  startTime      DateTime
  endTime        DateTime
  timezone       String
  location       String?
  isVirtual      Boolean  @default(false)
  meetingUrl     String?
  recurring      Json?
  reminders      Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organizer User              @relation(fields: [organizerId], references: [id])
  attendees MeetingAttendee[]

  @@map("meetings")
}

model MeetingAttendee {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  meetingId    String    @db.ObjectId
  userId       String    @db.ObjectId
  timezone     String
  status       String
  responseTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("meeting_attendees")
}

model Task {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  assigneeId     String    @db.ObjectId
  assignerId     String    @db.ObjectId
  organizationId String    @db.ObjectId
  projectId      String?   @db.ObjectId
  status         String
  priority       String
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  timezone       String
  tags           String[]
  attachments    Json?
  dependencies   String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  assignee     User                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigner     User                @relation("TaskCreator", fields: [assignerId], references: [id])
  project      Project?            @relation(fields: [projectId], references: [id])
  timeTracking TimeTrackingEntry[]
  comments     TaskComment[]

  @@map("tasks")
}

model TaskComment {
