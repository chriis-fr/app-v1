model FinancialPeriod {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  startDate      DateTime
  endDate        DateTime
  name           String
  organizationId String   @db.ObjectId
}

model JournalEntry {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  date           DateTime
  reference      String
  description    String
  organizationId String        @db.ObjectId
  createdById    String        @db.ObjectId
  lines          JournalLine[]
}

model JournalLine {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  accountId   String        @db.ObjectId
  description String
  debit       Float
  credit      Float
  entryId     String        @db.ObjectId
  account     Account       @relation(fields: [accountId], references: [id])
  entry       JournalEntry  @relation(fields: [entryId], references: [id])
}

model LeaveEntitlement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
}

model ModuleAccess {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  module    String
  access    String   @default("read_write")
  userId    String   @db.ObjectId
  user      User     @relation("UserModuleAccess", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moduleAccess")
}

model Organization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String // Organization type: e.g., business, SME, NGO, large, etc.
  industry      String
  size          String?
  walletAddress String?
  activeModules String[]
  maxModules    Int      @default(3)
  address       String?
  country       String?
  taxId         String?
  website       String?
  settings      Json?
  roles         Json?
  accountingSettings Json?
  waitlistedModules String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]   @relation("OrgUsers")

  @@map("organizations")
}

