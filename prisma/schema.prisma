model Notification {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  type           String // meeting, task, approval, system, user, finance, inventory
  title          String
  message        String
  userId         String       @db.ObjectId
  user           User         @relation("UserNotifications", fields: [userId], references: [id])
  organizationId String       @db.ObjectId
  organization   Organization @relation("OrgNotifications", fields: [organizationId], references: [id])
  priority       String       @default("medium") // low, medium, high
  isRead         Boolean      @default(false)
  actionUrl      String?
  metadata       String? // JSON string for additional data
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("notifications")
}

model JobPosting {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  organizationId      String           @db.ObjectId
  organization        Organization     @relation("OrgJobPostings", fields: [organizationId], references: [id])
  title               String
  department          String
  location            String
  employmentType      String
  experienceLevel     String
  salary              Json?
  description         String
  requirements        Json?
  responsibilities    Json?
  benefits            Json?
  applicationDeadline DateTime?
  status              String           @default("draft")
  isPublic            Boolean          @default(true)
  publicId            String           @unique
  views               Int              @default(0)
  applications        Int              @default(0)
  createdBy           String           @db.ObjectId
  createdByUser       User             @relation("UserJobPostings", fields: [createdBy], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  JobApplication      JobApplication[]

  @@map("job_postings")
}

model JobApplication {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  jobPostingId        String       @db.ObjectId
  jobPosting          JobPosting   @relation(fields: [jobPostingId], references: [id])
  organizationId      String       @db.ObjectId
  organization        Organization @relation("OrgJobApplications", fields: [organizationId], references: [id])
  firstName           String
  lastName            String
  email               String
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  address             Json?
  currentPosition     String?
  currentCompany      String?
  experience          Int?
  education           String?
  skills              Json?
  certifications      Json?
  languages           Json?
  coverLetter         String?
  expectedSalary      Json?
  availability        String?
  resume              Json?
  additionalDocuments Json?
  status              String       @default("pending")
  reviewedBy          String?      @db.ObjectId
  reviewedByUser      User?        @relation("UserJobApplicationReviews", fields: [reviewedBy], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  interviews          Json?
  communications      Json?
  source              String       @default("website")
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("job_applications")
}

model PayrollRun {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  organization   Organization   @relation("OrgPayrollRuns", fields: [organizationId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  totalAmount    Float
  currency       String
  employeeCount  Int
  status         String         @default("draft") // draft, pending_approval, approved, processing, completed, failed
  approvedBy     String?        @db.ObjectId
  approvedByUser User?          @relation("UserPayrollApprovals", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  processedAt    DateTime?
  entries        PayrollEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("payroll_runs")
}

model PayrollEntry {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  payrollRunId      String     @db.ObjectId
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId        String     @db.ObjectId
  employee          User       @relation("UserPayrollEntries", fields: [employeeId], references: [id])
  baseSalary        Float
  overtimeHours     Float?
  overtimeRate      Float?
  bonuses           Float?
  taxDeduction      Float
  benefitsDeduction Float
  otherDeductions   Float
  netPay            Float
  paymentMethod     String // bank, crypto, hybrid
  bankAccount       Json?
  cryptoWallet      Json?
  status            String     @default("pending") // pending, approved, processing, completed, failed
  processedAt       DateTime?
  transactionHash   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("payroll_entries")
}

model PayrollConfig {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId     String       @db.ObjectId
  organization       Organization @relation("OrgPayrollConfigs", fields: [organizationId], references: [id])
  paymentMethod      String       @default("traditional") // traditional, crypto, hybrid
  currency           String       @default("USD")
  cryptoCurrency     String?
  paymentSchedule    String       @default("monthly") // weekly, biweekly, monthly
  paymentDay         Int          @default(1)
  autoProcess        Boolean      @default(false)
  requireApproval    Boolean      @default(true)
  taxDeductions      Boolean      @default(true)
  benefitsDeductions Boolean      @default(true)
  overtimeEnabled    Boolean      @default(true)
  bonusEnabled       Boolean      @default(true)
  taxRates           Json? // Tax rates by location/income level
  benefitRates       Json? // Benefit deduction rates
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("payroll_configs")
}

model ProcurementRequest {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  prNumber        String               @unique // Purchase Requisition Number
  title           String
  description     String
  category        String // e.g., "Office Supplies", "Software", "Equipment"
  estimatedAmount Float
  priority        String // "Low", "Medium", "High", "Urgent"
  urgency         String // "Normal", "Urgent", "Critical"
  status          String // "Draft", "Submitted", "Under Review", "Approved", "Rejected", "In Progress", "Completed"
  requestorId     String               @db.ObjectId
  requestor       User                 @relation(fields: [requestorId], references: [id])
  department      String
  justification   String
  attachments     String[] // URLs to uploaded files
  budgetCode      String? // Budget allocation code
  spendThreshold  String // "Low", "Medium", "High" based on amount
  approvalLevel   String // "Department", "Finance", "Executive", "Board"
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  approvedAt      DateTime?
  approvedBy      String?              @db.ObjectId
  approver        User?                @relation("ProcurementApprover", fields: [approvedBy], references: [id])
  rejectionReason String?
  organizationId  String               @db.ObjectId
  organization    Organization         @relation(fields: [organizationId], references: [id])
  comments        ProcurementComment[]
  purchaseOrders  PurchaseOrder[]
  rfps            RFP[]
  contracts       Contract[]

  @@map("procurement_requests")
}

model PurchaseOrder {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  poNumber             String              @unique
  procurementRequestId String?             @db.ObjectId
  procurementRequest   ProcurementRequest? @relation(fields: [procurementRequestId], references: [id])
  supplierId           String              @db.ObjectId
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  totalAmount          Float
  currency             String              @default("USD")
  status               String // "Draft", "Sent", "Confirmed", "In Progress", "Delivered", "Completed", "Cancelled"
  orderDate            DateTime            @default(now())
  expectedDelivery     DateTime?
  actualDelivery       DateTime?
  terms                String
  notes                String?
  createdBy            String              @db.ObjectId
  creator              User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  approvedBy           String?             @db.ObjectId
  approver             User?               @relation("PurchaseOrderApprover", fields: [approvedBy], references: [id])
  approvedAt           DateTime?
  organizationId       String              @db.ObjectId
  organization         Organization        @relation(fields: [organizationId], references: [id])
  items                PurchaseOrderItem[]
  payments             Payment[]
  contracts            Contract[]
  grns                 GoodsReceivedNote[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId  String        @db.ObjectId
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productName      String
  description      String?
  quantity         Int
  unitPrice        Float
  totalPrice       Float
  receivedQuantity Int           @default(0)
  grnItems         GRNItem[]

  @@map("purchase_order_items")
}

model Supplier {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  contactPerson  String?
  email          String
  phone          String?
  address        String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  taxId          String?
  website        String?
  category       String? // e.g., "Office Supplies", "IT Equipment", "Services"
  rating         Float? // 1-5 rating
  status         String          @default("Active") // "Active", "Inactive", "Blacklisted"
  paymentTerms   String? // e.g., "Net 30", "Net 60"
  creditLimit    Float?
  notes          String?
  organizationId String          @db.ObjectId
  organization   Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders PurchaseOrder[]
  rfpResponses   RFPResponse[]
  contracts      Contract[]
  performances   VendorPerformance[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("suppliers")
}

model ExpenseRequest {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  amount         Float
  currency       String               @default("USD")
  category       String // e.g., "Travel", "Meals", "Office Supplies", "Training"
  status         String // "Draft", "Submitted", "Under Review", "Approved", "Rejected", "Paid"
  requestorId    String               @db.ObjectId
  requestor      User                 @relation("ExpenseRequestor", fields: [requestorId], references: [id])
  department     String
  justification  String
  receipts       String[] // URLs to uploaded receipts
  approvedBy     String?              @db.ObjectId
  approver       User?                @relation("ExpenseApprover", fields: [approvedBy], references: [id])
  approvedAt     DateTime?
  paidAt         DateTime?
  paidBy         String?              @db.ObjectId
  payer          User?                @relation("ExpensePayer", fields: [paidBy], references: [id])
  organizationId String               @db.ObjectId
  organization   Organization         @relation(fields: [organizationId], references: [id])
  comments       ProcurementComment[]
  payments       Payment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("expense_requests")
}

model ProcurementComment {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  content              String
  authorId             String              @db.ObjectId
  author               User                @relation(fields: [authorId], references: [id])
  procurementRequestId String?             @db.ObjectId
  procurementRequest   ProcurementRequest? @relation(fields: [procurementRequestId], references: [id])
  expenseRequestId     String?             @db.ObjectId
  expenseRequest       ExpenseRequest?     @relation(fields: [expenseRequestId], references: [id])
  createdAt            DateTime            @default(now())

  @@map("procurement_comments")
}

model Payment {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  amount           Float
  currency         String          @default("USD")
  paymentMethod    String // "Bank Transfer", "Check", "Credit Card", "Cash"
  reference        String? // Payment reference number
  purchaseOrderId  String?         @db.ObjectId
  purchaseOrder    PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  expenseRequestId String?         @db.ObjectId
  expenseRequest   ExpenseRequest? @relation(fields: [expenseRequestId], references: [id])
  status           String          @default("Pending") // "Pending", "Completed", "Failed", "Cancelled"
  paidBy           String?         @db.ObjectId
  payer            User?           @relation("PaymentPayer", fields: [paidBy], references: [id])
  paidAt           DateTime?
  organizationId   String          @db.ObjectId
  organization     Organization    @relation(fields: [organizationId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("payments")
}

model Budget {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  amount          Float
  currency        String       @default("USD")
  period          String // "Monthly", "Quarterly", "Yearly"
  startDate       DateTime
  endDate         DateTime
  department      String?
  category        String?
  spentAmount     Float        @default(0)
  remainingAmount Float
  status          String       @default("Active") // "Active", "Inactive", "Exceeded"
  organizationId  String       @db.ObjectId
  organization    Organization @relation(fields: [organizationId], references: [id])
  createdBy       String       @db.ObjectId
  creator         User         @relation(fields: [createdBy], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("budgets")
}

// ============================================================================
// ENHANCED PROCUREMENT SYSTEM MODELS
// ============================================================================

model ProcurementPolicy {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  description           String
  spendThresholds       Json         // Approval limits by amount
  approvalWorkflow      Json         // Dynamic approval workflow
  ethicalStandards      Json         // Anti-bribery, fair competition rules
  mandatorySteps        String[]     // Required steps in procurement lifecycle
  isActive              Boolean      @default(true)
  organizationId        String       @db.ObjectId
  organization          Organization  @relation(fields: [organizationId], references: [id])
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("procurement_policies")
}

model RFP {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  rfpNumber             String               @unique
  title                 String
  description           String
  requirements          String
  evaluationCriteria    Json                 // Technical, price, delivery, compliance criteria
  submissionDeadline    DateTime
  status                String               @default("Draft") // "Draft", "Published", "Closed", "Evaluated"
  procurementRequestId  String               @db.ObjectId
  procurementRequest    ProcurementRequest   @relation(fields: [procurementRequestId], references: [id])
  organizationId        String               @db.ObjectId
  organization          Organization         @relation(fields: [organizationId], references: [id])
  createdBy             String               @db.ObjectId
  creator               User                 @relation("RFPCreator", fields: [createdBy], references: [id])
  responses             RFPResponse[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("rfps")
}

model RFPResponse {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  rfpId         String        @db.ObjectId
  rfp           RFP           @relation(fields: [rfpId], references: [id])
  supplierId    String        @db.ObjectId
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  proposal      String
  price         Float
  deliveryTime  Int           // Days
  technicalScore Float?
  priceScore    Float?
  totalScore    Float?
  status        String        @default("Submitted") // "Submitted", "Under Review", "Shortlisted", "Selected", "Rejected"
  submittedAt   DateTime      @default(now())
  evaluatedAt   DateTime?
  evaluatedBy   String?       @db.ObjectId
  evaluator     User?         @relation("RFPResponseEvaluator", fields: [evaluatedBy], references: [id])
  notes         String?

  @@map("rfp_responses")
}

model Contract {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  contractNumber        String               @unique
  title                 String
  description           String
  supplierId            String               @db.ObjectId
  supplier              Supplier             @relation(fields: [supplierId], references: [id])
  procurementRequestId  String?              @db.ObjectId
  procurementRequest    ProcurementRequest?  @relation(fields: [procurementRequestId], references: [id])
  purchaseOrderId       String?              @db.ObjectId
  purchaseOrder         PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  contractType          String               // "Service", "Goods", "Mixed"
  startDate             DateTime
  endDate               DateTime
  totalValue            Float
  currency              String               @default("USD")
  paymentTerms          String
  sla                   Json?                // Service Level Agreements
  penalties             Json?                // Penalty clauses
  status                String               @default("Draft") // "Draft", "Under Review", "Active", "Completed", "Terminated"
  legalReviewBy         String?              @db.ObjectId
  legalReviewer         User?                @relation("ContractLegalReviewer", fields: [legalReviewBy], references: [id])
  legalReviewAt         DateTime?
  approvedBy            String?              @db.ObjectId
  approver              User?                @relation("ContractApprover", fields: [approvedBy], references: [id])
  approvedAt            DateTime?
  organizationId        String               @db.ObjectId
  organization          Organization         @relation(fields: [organizationId], references: [id])
  createdBy             String               @db.ObjectId
  creator               User                 @relation("ContractCreator", fields: [createdBy], references: [id])
  attachments           String[]             // Contract documents
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@map("contracts")
}

model GoodsReceivedNote {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  grnNumber             String              @unique
  purchaseOrderId       String              @db.ObjectId
  purchaseOrder         PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  receivedDate          DateTime            @default(now())
  receivedBy            String              @db.ObjectId
  receiver              User                @relation("GRNReceiver", fields: [receivedBy], references: [id])
  status                String              @default("Received") // "Received", "Partially Received", "Rejected"
  notes                 String?
  organizationId        String              @db.ObjectId
  organization          Organization        @relation(fields: [organizationId], references: [id])
  items                 GRNItem[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("goods_received_notes")
}

model GRNItem {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  grnId                 String              @db.ObjectId
  grn                   GoodsReceivedNote   @relation(fields: [grnId], references: [id])
  purchaseOrderItemId   String              @db.ObjectId
  purchaseOrderItem     PurchaseOrderItem   @relation(fields: [purchaseOrderItemId], references: [id])
  receivedQuantity      Int
  acceptedQuantity      Int
  rejectedQuantity      Int                 @default(0)
  rejectionReason       String?
  qualityCheck          String?             // "Pass", "Fail", "Conditional"
  notes                 String?

  @@map("grn_items")
}

model VendorPerformance {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  supplierId            String        @db.ObjectId
  supplier              Supplier      @relation(fields: [supplierId], references: [id])
  evaluationPeriod      String        // "Monthly", "Quarterly", "Yearly"
  evaluationDate        DateTime      @default(now())
  qualityScore          Float         // 1-5 rating
  deliveryScore         Float         // 1-5 rating
  priceScore            Float         // 1-5 rating
  communicationScore    Float         // 1-5 rating
  overallScore          Float
  strengths             String[]
  weaknesses            String[]
  recommendations       String
  evaluatedBy           String        @db.ObjectId
  evaluator            User           @relation("VendorPerformanceEvaluator", fields: [evaluatedBy], references: [id])
  organizationId        String        @db.ObjectId
  organization          Organization   @relation(fields: [organizationId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("vendor_performances")
}

model ProcurementAudit {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  auditNumber           String        @unique
  auditType             String        // "Compliance", "Performance", "Risk"
  auditPeriod           String        // "Monthly", "Quarterly", "Yearly"
  startDate             DateTime
  endDate               DateTime
  scope                 String
  findings              Json
  recommendations       String[]
  status                String        @default("In Progress") // "In Progress", "Completed", "Follow-up Required"
  auditorId             String        @db.ObjectId
  auditor               User           @relation("ProcurementAuditor", fields: [auditorId], references: [id])
  organizationId        String        @db.ObjectId
  organization          Organization   @relation(fields: [organizationId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("procurement_audits")
}

model ProcurementCommittee {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  description           String
  spendThreshold        Float         // Minimum spend for committee review
  members               String[]      // User IDs
  isActive              Boolean       @default(true)
  organizationId        String        @db.ObjectId
  organization          Organization   @relation(fields: [organizationId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("procurement_committees")
}
