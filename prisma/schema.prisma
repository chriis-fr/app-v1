generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

type OrganizationsRoles {
  description  String
  isSystem     Boolean
  moduleAccess OrganizationsRolesModuleAccess[]
  name         String
  permissions  String[]
}

type OrganizationsRolesModuleAccess {
  access String
  module String
}

type OrganizationsSettings {
  backup             OrganizationsSettingsBackup
  branding           OrganizationsSettingsBranding
  integrations       OrganizationsSettingsIntegrations
  legalCompliance    OrganizationsSettingsLegalCompliance
  modules            OrganizationsSettingsModules
  notifications      OrganizationsSettingsNotifications
  primaryModule      String
  recommendedModules String[]
  security           OrganizationsSettingsSecurity
  theme              OrganizationsSettingsTheme
}

type OrganizationsSettingsBackup {
  autoBackup     Boolean
  backupLocation String
  frequency      String
  /// Could not determine type: the field only had null or empty values in the sample set.
  lastBackup     Json?
  nextBackup     String
  retention      Int
}

type OrganizationsSettingsBranding {
  address     String
  companyName String
  email       String
  /// Could not determine type: the field only had null or empty values in the sample set.
  favicon     Json?
  /// Could not determine type: the field only had null or empty values in the sample set.
  logo        Json?
  phone       String
  socialMedia OrganizationsSettingsBrandingSocialMedia
  tagline     String
  website     String
}

type OrganizationsSettingsBrandingSocialMedia {
  facebook  String
  instagram String
  linkedin  String
  twitter   String
}

type OrganizationsSettingsIntegrations {
  emailService    OrganizationsSettingsIntegrationsEmailService
  /// Could not determine type: the field only had null or empty values in the sample set.
  paymentGateways Json?
  smsService      OrganizationsSettingsIntegrationsSmsService
  storage         OrganizationsSettingsIntegrationsStorage
}

type OrganizationsSettingsIntegrationsEmailService {
  apiKey    String
  fromEmail String
  provider  String
}

type OrganizationsSettingsIntegrationsSmsService {
  apiKey     String
  fromNumber String
  provider   String
}

type OrganizationsSettingsIntegrationsStorage {
  accessKey String
  bucket    String
  provider  String
  region    String
  secretKey String
}

type OrganizationsSettingsLegalCompliance {
  businessType        String
  /// Could not determine type: the field only had null or empty values in the sample set.
  complianceDocuments Json?
  currency            String
  dataProtection      OrganizationsSettingsLegalComplianceDataProtection
  fiscalYearStart     String
  incorporationDate   String
  registrationNumber  String
  taxId               String
  vatNumber           String
}

type OrganizationsSettingsLegalComplianceDataProtection {
  dataRetentionPeriod Int
  gdprCompliant       Boolean
  privacyPolicyUrl    String
  termsOfServiceUrl   String
}

type OrganizationsSettingsModules {
  defaultModule  String
  enabled        String[]
  moduleSettings OrganizationsSettingsModulesModuleSettings
}

type OrganizationsSettingsModulesModuleSettings {
  accounting OrganizationsSettingsModulesModuleSettingsAccounting
  hr         OrganizationsSettingsModulesModuleSettingsHr
  inventory  OrganizationsSettingsModulesModuleSettingsInventory
}

type OrganizationsSettingsModulesModuleSettingsAccounting {
  currency        String
  fiscalYearStart String
  invoicePrefix   String
  paymentTerms    String
  taxRate         Int
}

type OrganizationsSettingsModulesModuleSettingsHr {
  enableLeaveManagement    Boolean
  enablePayroll            Boolean
  enablePerformanceReviews Boolean
  enableTimeTracking       Boolean
}

type OrganizationsSettingsModulesModuleSettingsInventory {
  enableBarcode       Boolean
  enableSerialNumbers Boolean
  lowStockThreshold   Int
  reorderPoint        Int
}

type OrganizationsSettingsNotifications {
  email OrganizationsSettingsNotificationsEmail
  push  OrganizationsSettingsNotificationsPush
  sms   OrganizationsSettingsNotificationsSms
}

type OrganizationsSettingsNotificationsEmail {
  enabled      Boolean
  fromEmail    String
  smtpPassword String
  smtpPort     Int
  smtpServer   String
  smtpUsername String
}

type OrganizationsSettingsNotificationsPush {
  enabled         Boolean
  vapidPrivateKey String
  vapidPublicKey  String
}

type OrganizationsSettingsNotificationsSms {
  apiKey     String
  enabled    Boolean
  fromNumber String
  provider   String
}

type OrganizationsSettingsSecurity {
  /// Could not determine type: the field only had null or empty values in the sample set.
  allowedDomains Json?
  /// Could not determine type: the field only had null or empty values in the sample set.
  ipWhitelist    Json?
  passwordPolicy OrganizationsSettingsSecurityPasswordPolicy
  sessionTimeout Int
  twoFactorAuth  Boolean
}

type OrganizationsSettingsSecurityPasswordPolicy {
  maxAge              Int
  minLength           Int
  requireLowercase    Boolean
  requireNumbers      Boolean
  requireSpecialChars Boolean
  requireUppercase    Boolean
}

type OrganizationsSettingsTheme {
  borderRadius   String
  darkMode       Boolean
  fontFamily     String
  primaryColor   String
  secondaryColor String
  spacing        String
}

