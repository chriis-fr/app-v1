model TimeTrackingEntry {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  organizationId String    @db.ObjectId
  projectId      String?   @db.ObjectId
  taskId         String?   @db.ObjectId
  description    String
  type           String
  status         String
  startTime      DateTime
  endTime        DateTime?
  duration       Int? // in minutes
  timezone       String
  location       String?
  tags           String[]
  notes          String?
  billable       Boolean   @default(false)
  hourlyRate     Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])

  @@map("time_tracking_entries")
}

model Meeting {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  organizerId    String   @db.ObjectId
  organizationId String   @db.ObjectId
  type           String
  status         String
  startTime      DateTime
  endTime        DateTime
  timezone       String
  location       String?
  isVirtual      Boolean  @default(false)
  meetingUrl     String?
  recurring      Json?
  reminders      Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organizer User              @relation(fields: [organizerId], references: [id])
  attendees MeetingAttendee[]

  @@map("meetings")
}

model MeetingAttendee {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  meetingId    String    @db.ObjectId
  userId       String    @db.ObjectId
  timezone     String
  status       String
  responseTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  meeting Meeting @relation(fields: [meetingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("meeting_attendees")
}

model Task {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  assigneeId     String    @db.ObjectId
  assignerId     String    @db.ObjectId
  organizationId String    @db.ObjectId
  projectId      String?   @db.ObjectId
  status         String
  priority       String
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  timezone       String
  tags           String[]
  attachments    Json?
  dependencies   String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  assignee     User                @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigner     User                @relation("TaskCreator", fields: [assignerId], references: [id])
  project      Project?            @relation(fields: [projectId], references: [id])
  timeTracking TimeTrackingEntry[]
  comments     TaskComment[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  userId    String   @db.ObjectId
  content   String
  timestamp DateTime
  timezone  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model Project {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  organizationId String    @db.ObjectId
  status         String
  startDate      DateTime?
  endDate        DateTime?
  timezone       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  timeTracking TimeTrackingEntry[]
  tasks        Task[]

  @@map("projects")
}

model Notification {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  type           String // meeting, task, approval, system, user, finance, inventory
  title          String
  message        String
  userId         String       @db.ObjectId
  user           User         @relation("UserNotifications", fields: [userId], references: [id])
  organizationId String       @db.ObjectId
  organization   Organization @relation("OrgNotifications", fields: [organizationId], references: [id])
  priority       String       @default("medium") // low, medium, high
  isRead         Boolean      @default(false)
  actionUrl      String?
  metadata       String? // JSON string for additional data
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("notifications")
}

model JobPosting {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  organizationId      String           @db.ObjectId
  organization        Organization     @relation("OrgJobPostings", fields: [organizationId], references: [id])
  title               String
  department          String
  location            String
  employmentType      String
  experienceLevel     String
  salary              Json?
  description         String
  requirements        Json?
  responsibilities    Json?
  benefits            Json?
  applicationDeadline DateTime?
  status              String           @default("draft")
  isPublic            Boolean          @default(true)
  publicId            String           @unique
  views               Int              @default(0)
  applications        Int              @default(0)
  createdBy           String           @db.ObjectId
  createdByUser       User             @relation("UserJobPostings", fields: [createdBy], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  JobApplication      JobApplication[]

  @@map("job_postings")
}

model JobApplication {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  jobPostingId        String       @db.ObjectId
  jobPosting          JobPosting   @relation(fields: [jobPostingId], references: [id])
  organizationId      String       @db.ObjectId
  organization        Organization @relation("OrgJobApplications", fields: [organizationId], references: [id])
  firstName           String
  lastName            String
  email               String
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  address             Json?
  currentPosition     String?
  currentCompany      String?
  experience          Int?
  education           String?
  skills              Json?
  certifications      Json?
  languages           Json?
  coverLetter         String?
  expectedSalary      Json?
  availability        String?
  resume              Json?
  additionalDocuments Json?
  status              String       @default("pending")
  reviewedBy          String?      @db.ObjectId
  reviewedByUser      User?        @relation("UserJobApplicationReviews", fields: [reviewedBy], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  interviews          Json?
  communications      Json?
  source              String       @default("website")
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("job_applications")
}
