model User {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  username         String        @unique
  email            String        @unique
  password         String
  role             String
  department       String?
  firstName        String?
  lastName         String?
  phoneNumber      String?
  organizationId   String        @db.ObjectId
  organization     Organization? @relation("OrgUsers", fields: [organizationId], references: [id])
  isOwner          Boolean?      @default(false)
  isActive         Boolean?      @default(false)
  emailVerified    Boolean?      @default(false)
  activationToken  String?
  tokenExpiresAt   DateTime?
  moduleAccess     ModuleAccess[] @relation("UserModuleAccess")
  permissions      Json?
  position         String?
  status           String?       @default("active")
  lastLogin        DateTime?
  employeeId       String?
  hireDate         DateTime?
  managerId        String?
  team             String?
  location         Json?
  workSchedule     Json?
  emergencyContact Json?
  skills           String[]
  certifications   String[]
  education        Json?
  performance      Json?
  compensation     Json?
  benefits         Json?
  equipment        Json?
  accessLevels     Json?
  documents        Json?
  wallet           Json?
  legalDetails     Json?
  address          Json?
  avatarUrl        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("users")
}

