# AI Chatbot Service Environment Variables

# API Configuration
API_V1_STR=/api
PROJECT_NAME=AI Chatbot Service

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq Configuration (Required)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database (Optional - for future enhancements)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_chatbot

# AI Model Configuration
MODEL_NAME=llama3-8b-8192
MAX_TOKENS=4096
TEMPERATURE=0.7

# Server Configuration
PORT=8000
HOST=0.0.0.0 