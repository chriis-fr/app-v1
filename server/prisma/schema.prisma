model User {
  id            String         @id @default(cuid())
  username      String
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          String
  department    String
  position      String
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  moduleAccess  ModuleAccess[]
}

model ModuleAccess {
  id        String   @id @default(cuid())
  userId    String
  moduleName String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleName])
} 