datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model Organization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  type          String
  industry      String
  size          String?
  walletAddress String?  @unique
  activeModules String[]
  maxModules    Int      @default(2)
  address       String?
  country       String?
  taxId         String?
  website       String?
  settings      Json?
  roles         Json?
  users         User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("organizations")
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  username      String
  email         String        @unique
  password      String
  role          String
  department    String?
  firstName     String?
  lastName      String?
  phoneNumber   String?
  position      String?
  organizationId String?      @db.ObjectId
  organization  Organization? @relation(fields: [organizationId], references: [id])
  isOwner       Boolean?
  status        String?       @default("active")
  lastLogin     DateTime?
  employeeId    String?
  hireDate      DateTime?
  managerId     String?       @db.ObjectId
  team          String?
  location      Json?
  workSchedule  Json?
  emergencyContact Json?
  skills        Json?
  certifications Json?
  education     Json?
  performance   Json?
  compensation  Json?
  benefits      Json?
  equipment     Json?
  accessLevels  Json?
  documents     Json?
  wallet        Json?
  legalDetails  Json?
  address       Json?
  moduleAccess  ModuleAccess[]
  permissions   Json?         @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model ModuleAccess {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  module    String
  access    String   @default("read_write")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("moduleAccess")
} 